generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Enums ──

enum YenLedgerReason {
  CONVERT_IN
  CASH_OUT
  CASH_FEE
  BONUS
  EXPENSE_DEDUCT
  ADJUSTMENT
}

enum LedgerReason {
  STUDY
  CHORE
  PENALTY
  CONVERT_OUT
  CONSUME
  ADJUSTMENT
}

enum LedgerSourceType {
  STUDY_LOG
  CHORE_CLAIM
  PENALTY_EVENT
  TIME_CONVERT
  TIME_CONSUME
  ADJUSTMENT
}

enum EventCategory {
  BIRTHDAY
  TRIP
  EXAM
  SCHOOL
  FAMILY
  OTHER
}

enum ParticipantRole {
  ORGANIZER
  ATTENDEE
  OBSERVER
}

// UserRole は将来的な型付けのために定義。既存の role String フィールドは変更しない
enum UserRole {
  PARENT
  CHILD
}

enum ItemMode {
  FIXED
  PROPORTIONAL
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Core Models ──

model Family {
  id             String          @id @default(cuid())
  name           String
  createdAt      DateTime        @default(now())
  users          User[]
  virtualMembers VirtualMember[]
  events         Event[]
  templates      EventTemplate[]
  choreItems     ChoreItem[]
  penaltyItems   PenaltyItem[]
}

model User {
  id                 String             @id
  familyId           String
  family             Family             @relation(fields: [familyId], references: [id])
  displayName        String
  role               String
  birthDate          DateTime?
  gradeOverride      String?
  exchangeRate       Float?
  colorToken         String?
  isActive           Boolean            @default(true)
  passwordHash       String
  mustChangePassword Boolean            @default(true)
  createdAt          DateTime           @default(now())
  requests           Request[]
  balance            Balance?
  expenseDeductions  ExpenseDeduction[]
  cashRequests       CashRequest[]
  savingsGoals       SavingsGoal[]
  passkeys           Passkey[]
  pushSubscriptions  PushSubscription[]
  auditLogs          AuditLog[]
  comments           Comment[]
  scheduledBonuses   ScheduledBonus[]
  userBadges         UserBadge[]
  windfall           WindfallIncome[]
  spending           SpendingRecord[]
  createdEvents      Event[]            @relation("EventCreatedBy")
  eventComments      EventComment[]
  eventReactions     EventReaction[]
  eventParticipants  EventParticipant[]
  yenLedgers         YenLedger[]
  timeLedgers        TimeLedger[]
  choreOverrides     UserChoreOverride[]
  penaltyOverrides   UserPenaltyOverride[]
  studyLogs          StudyLog[]
  choreClaims        ChoreClaim[]
  penaltyEvents      PenaltyEvent[]
  timeConverts       TimeConvert[]
  cashOuts           CashOut[]
  timeConsumes       TimeConsume[]
}

model Balance {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  accumulatedMin Int      @default(0)
  carryoverMin   Int      @default(0)
  virtualAmount  Int      @default(0)
  totalCashed    Int      @default(0)
  totalDeducted  Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model MasterItem {
  id          String         @id @default(cuid())
  category    String
  name        String
  description String?
  defaultMin  Int
  isActive    Boolean        @default(true)
  overrides   ItemOverride[]
  requests    Request[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ItemOverride {
  id          String     @id @default(cuid())
  itemId      String
  item        MasterItem @relation(fields: [itemId], references: [id])
  userId      String
  overrideMin Int

  @@unique([itemId, userId])
}

model Request {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  itemId         String
  item           MasterItem        @relation(fields: [itemId], references: [id])
  minutes        Int
  count          Int               @default(1)
  note           String?
  studyActualMin Int?
  status         String            @default("pending")
  rejectReason   String?
  requestedAt    DateTime          @default(now())
  reviewedAt     DateTime?
  reviewerId     String?
  settledAt      DateTime?
  attachments    Attachment[]
  comments       Comment[]
  undoToken      RequestUndoToken?
}

model CashRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  amount       Int
  fee          Int       @default(500)
  status       String    @default("pending")
  rejectReason String?
  requestedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewerId   String?
  paidAt       DateTime?
}

model ExpenseDeduction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  amount       Int
  reason       String
  registeredBy String
  createdAt    DateTime @default(now())
}

model SettlementLog {
  id              String   @id @default(cuid())
  userId          String
  totalMin        Int
  convertedAmount Int
  carryoverMin    Int
  settledAt       DateTime @default(now())
}

model SavingsGoal {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  title                String
  targetAmount         Int
  memo                 String?
  isAchieved           Boolean   @default(false)
  targetDate           DateTime?
  linkedEventId        String?
  linkedEvent          Event?    @relation(fields: [linkedEventId], references: [id])
  dailySuggestedAmount Int?
  createdAt            DateTime  @default(now())
}

// ── Phase A: New Feature Models ──

// 申請への画像添付（任意）
model Attachment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url       String
  mimeType  String
  byteSize  Int
  createdAt DateTime @default(now())

  @@index([requestId])
}

// 申請ごとのコメントスレッド（親子間メッセージ）
model Comment {
  id        String    @id @default(cuid())
  requestId String
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([requestId, createdAt])
}

// 監査ログ（誰がいつ何を）
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  diff       String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// Push 購読
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// パスキー（WebAuthn）認証情報
model Passkey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  nickname     String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
}

// 定期ボーナス設定（管理者が子供ごとに設定）
model ScheduledBonus {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  type        String    // "monthly" | "birthday"
  amountYen   Int
  dayOfMonth  Int?
  isActive    Boolean   @default(true)
  lastApplied DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// バッジ定義
model Badge {
  id         String      @id
  label      String
  icon       String
  condition  String
  userBadges UserBadge[]
}

// ユーザーが獲得したバッジ
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

// 臨時収入（お年玉・プレゼント等）
model WindfallIncome {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  label      String
  note       String?
  recordedBy String
  recordedAt DateTime @default(now())

  @@index([userId])
}

// 支出記録（子供が何にいくら使ったか）
model SpendingRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  category   String   // "food"|"toy"|"game"|"book"|"outing"|"other"
  memo       String?
  recordedAt DateTime @default(now())

  @@index([userId])
}

// 取消（Undo）トークン
model RequestUndoToken {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Phase 1: Calendar & Family Models ──

// イベントテンプレート（誕生日・テスト・旅行など）
model EventTemplate {
  id              String        @id @default(cuid())
  familyId        String?
  family          Family?       @relation(fields: [familyId], references: [id])
  name            String
  category        EventCategory
  defaultBudget   Int?
  defaultLeadDays Int?
  description     String?
  events          Event[]
}

// 家族カレンダーイベント
model Event {
  id            String               @id @default(cuid())
  familyId      String
  family        Family               @relation(fields: [familyId], references: [id])
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime?
  allDay        Boolean              @default(false)
  location      String?
  category      EventCategory
  createdById   String
  createdBy     User                 @relation("EventCreatedBy", fields: [createdById], references: [id])
  templateId    String?
  template      EventTemplate?       @relation(fields: [templateId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  participants  EventParticipant[]
  comments      EventComment[]
  reactions     EventReaction[]
  retrospective EventRetrospective?
  savingsGoals  SavingsGoal[]

  @@index([familyId, startAt])
}

// イベント参加者（実ユーザーまたは仮想メンバー）
model EventParticipant {
  id              String          @id @default(cuid())
  eventId         String
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  virtualMemberId String?
  virtualMember   VirtualMember?  @relation(fields: [virtualMemberId], references: [id])
  role            ParticipantRole
}

// スマホ未所持の家族メンバー（祖父母など）
model VirtualMember {
  id           String             @id @default(cuid())
  familyId     String
  family       Family             @relation(fields: [familyId], references: [id])
  displayName  String
  colorTag     String?
  createdAt    DateTime           @default(now())
  participants EventParticipant[]
}

// イベントコメント（親子間コミュニケーション）
model EventComment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

// イベントリアクション（絵文字による軽量コミュニケーション）
model EventReaction {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())

  @@unique([eventId, userId, emoji])
}

// イベント振り返り
model EventRetrospective {
  id            String   @id @default(cuid())
  eventId       String   @unique
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plannedAmount Int?
  actualAmount  Int?
  note          String?
  createdAt     DateTime @default(now())
}

// ── P1: Ledger Models ──

// 円残高イベントログ
model YenLedger {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaYen  Int
  reason    YenLedgerReason
  sourceId  String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

// 時間残高イベントログ
model TimeLedger {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaMinutes Int
  reason       LedgerReason
  sourceType   LedgerSourceType
  sourceId     String?
  note         String?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
}

// ── P2: ChoreItem / PenaltyItem マスタ ──

model ChoreItem {
  id           String              @id @default(cuid())
  familyId     String
  family       Family              @relation(fields: [familyId], references: [id])
  category     String              // "おてつだい" | "べんきょう"
  name         String
  bonusMinutes Int
  mode         ItemMode            @default(FIXED)
  active       Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  overrides    UserChoreOverride[]
  claims       ChoreClaim[]

  @@index([familyId, sortOrder])
}

model UserChoreOverride {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  choreItemId  String
  choreItem    ChoreItem @relation(fields: [choreItemId], references: [id], onDelete: Cascade)
  bonusMinutes Int?
  active       Boolean   @default(true)

  @@unique([userId, choreItemId])
  @@index([userId])
}

model PenaltyItem {
  id             String                @id @default(cuid())
  familyId       String
  family         Family                @relation(fields: [familyId], references: [id])
  name           String
  penaltyMinutes Int
  mode           ItemMode              @default(FIXED)
  unitLabel      String?
  active         Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  overrides      UserPenaltyOverride[]
  events         PenaltyEvent[]

  @@index([familyId, sortOrder])
}

model UserPenaltyOverride {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  penaltyItemId  String
  penaltyItem    PenaltyItem @relation(fields: [penaltyItemId], references: [id], onDelete: Cascade)
  penaltyMinutes Int?
  active         Boolean     @default(true)

  @@unique([userId, penaltyItemId])
  @@index([userId])
}

// ── P3: 申請承認フロー ──

model StudyLog {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes        Int
  studiedAt      DateTime
  note           String?
  status         ClaimStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, studiedAt])
  @@index([userId, status])
}

model ChoreClaim {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  choreItemId    String
  choreItem      ChoreItem   @relation(fields: [choreItemId], references: [id])
  count          Int         @default(1)
  actualValue    Int?
  totalMinutes   Int
  performedAt    DateTime
  note           String?
  status         ClaimStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, status])
}

model PenaltyEvent {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  penaltyItemId String
  penaltyItem   PenaltyItem @relation(fields: [penaltyItemId], references: [id])
  count         Int         @default(1)
  actualValue   Int?
  totalMinutes  Int
  occurredAt    DateTime
  reason        String
  createdById   String
  createdAt     DateTime    @default(now())

  @@index([userId, occurredAt])
}

// ── P4: 時間→金額換算 ──

model TimeConvert {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutesUsed  Int
  yenGained    Int
  rateSnapshot Int      @default(500)
  convertedAt  DateTime @default(now())

  @@index([userId, convertedAt])
}

// ── P6: 時間消費カテゴリ ──

enum ConsumeCategory {
  GAME
  SMARTPHONE
  TV
  OTHER
}

// ── P5: 換金 ──

model CashOut {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grossYen     Int
  feeYen       Int      @default(500)
  netYen       Int
  approvedById String
  note         String?
  cashedOutAt  DateTime @default(now())

  @@index([userId, cashedOutAt])
}

// ── P6: 時間消費 ──

model TimeConsume {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    ConsumeCategory
  minutesUsed Int
  memo        String?
  consumedAt  DateTime        @default(now())

  @@index([userId, consumedAt])
}
